{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "description": "the schema this envelope follows: `illumio-tui schema NAME`"
    },
    "profile": {"type": "string"},
    "elapsed_ms": {"type": "integer"},
    "api_calls": {"type": "integer"},
    "bytes": {"type": "integer"},
    "cache": {"enum": ["hit", "miss", "bypass", "none"]},
    "truncated": {"type": "boolean"},
    "window": {
      "type": "object",
      "properties": {"start": {"type": "string"}, "end": {"type": "string"}},
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "covered": {
      "type": ["string", "null"],
      "description": "traffic: the window's length when the result is complete, null when truncated"
    },
    "cap": {"type": "integer", "description": "traffic: the cap the result was fetched at"},
    "cap_steps": {
      "type": "array",
      "items": {"type": "integer"},
      "description": "traffic with --backfill: every cap tried, in order"
    },
    "incomplete": {
      "type": "boolean",
      "description": "traffic: a supercluster region did not respond"
    },
    "queries": {
      "type": "integer",
      "description": "traffic with --app: the Explorer queries the result took"
    },
    "draft": {
      "type": "object",
      "properties": {
        "evaluated": {"type": "boolean"},
        "fixed": {"type": "integer"},
        "newly_blocked": {"type": "integer"}
      },
      "required": ["evaluated", "fixed", "newly_blocked"],
      "additionalProperties": false,
      "description": "traffic with --draft: the re-evaluation and its counts"
    },
    "write": {
      "type": "object",
      "properties": {
        "method": {"enum": ["POST", "PUT", "DELETE"]},
        "path": {"type": "string"},
        "status": {"type": "integer"},
        "audit": {"type": "string", "description": "audit log location"}
      },
      "required": ["method", "path", "status", "audit"],
      "additionalProperties": false,
      "description": "what a write did"
    },
    "usage": {"type": "string", "description": "labels --unused: where label usage came from"},
    "local_filter": {
      "type": "array",
      "items": {"type": "string"},
      "description": "filters applied locally after the request"
    },
    "hidden": {"type": "integer", "description": "events: loaded rows the local filters hid"},
    "warnings": {
      "type": "array",
      "items": {"type": "string"},
      "description": "warnings about the arguments that did not stop the command (also on stderr)"
    },
    "marks": {
      "type": "object",
      "properties": {
        "active": {"type": "integer"},
        "file": {"type": "string"},
        "waiting_draft": {"type": "integer"}
      },
      "required": ["active", "file"],
      "additionalProperties": false,
      "description": "the marks applied"
    },
    "squelched": {
      "type": "object",
      "properties": {"flows": {"type": "integer"}, "rows": {"type": "integer"}},
      "required": ["flows"],
      "additionalProperties": false,
      "description": "rows and flow records squelch removed"
    },
    "cost": {"type": "string", "description": "traffic explain and --baseline: the requests it makes, in words"},
    "compare": {
      "type": "object",
      "properties": {
        "length": {"type": "string", "description": "--baseline as given"},
        "changes": {"type": "string", "description": "the rows printed (--changes)"},
        "recent": {
          "type": "object",
          "properties": {
            "start": {"type": "string"},
            "end": {"type": "string"},
            "truncated": {"type": "boolean"},
            "incomplete": {"type": "boolean"},
            "cap": {"type": "integer"},
            "cache": {"enum": ["hit", "miss", "bypass", "none"]}
          },
          "required": ["start", "end", "truncated", "incomplete", "cap", "cache"],
          "additionalProperties": false
        },
        "baseline": {
          "type": "object",
          "properties": {
            "start": {"type": "string"},
            "end": {"type": "string"},
            "truncated": {"type": "boolean"},
            "incomplete": {"type": "boolean"},
            "cap": {"type": "integer"},
            "cache": {"enum": ["hit", "miss", "bypass", "none"]}
          },
          "required": ["start", "end", "truncated", "incomplete", "cap", "cache"],
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "properties": {
            "new": {"type": "integer"},
            "changed": {"type": "integer"},
            "gone": {"type": "integer"},
            "same": {"type": "integer"}
          },
          "required": ["new", "changed", "gone", "same"],
          "additionalProperties": false,
          "description": "rows per change, before --changes"
        }
      },
      "required": ["length", "changes", "recent", "baseline", "counts"],
      "additionalProperties": false,
      "description": "traffic with --baseline: both exact windows, each side's truncation, rows per change"
    },
    "matched": {
      "type": "object",
      "properties": {"matched": {"type": "integer"}, "loaded": {"type": "integer"}},
      "required": ["matched", "loaded"],
      "additionalProperties": false,
      "description": "policy search: the rules found of the rules loaded"
    },
    "where_used": {
      "type": "object",
      "properties": {
        "object": {"enum": ["label", "label_group", "ip_list", "service"]},
        "name": {"type": "string", "description": "key=value for a label, else the name"},
        "href": {"type": "string"},
        "total": {"type": "integer", "description": "references found, the workloads row not counted"},
        "workloads": {
          "type": ["object", "null"],
          "properties": {"count": {"type": "integer"}, "exact": {"type": "boolean"}},
          "required": ["count", "exact"],
          "additionalProperties": false,
          "description": "a label's workloads (exact false: at least count); null for the other kinds"
        },
        "deny_unread": {"type": "integer", "description": "rulesets whose deny rules were not searched"},
        "not_searched": {"type": "string"}
      },
      "required": ["object", "name", "href", "total", "workloads", "deny_unread", "not_searched"],
      "additionalProperties": false,
      "description": "where-used: the object, its references and workload count"
    }
  },
  "required": ["schema", "profile", "elapsed_ms", "api_calls", "bytes", "cache", "truncated"],
  "additionalProperties": false
}
